# --- OpenAI / LLM (optional in Increment 1; reserved for next increments) ---
OPENAI_API_KEY=

# --- JIRA Cloud ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your_jira_api_token

# Example JQL filter:
# JIRA_JQL=project = ABC AND sprint in openSprints() AND statusCategory != Done ORDER BY updated DESC
JIRA_JQL=

# Optional: limit issues in report
JIRA_MAX_RESULTS=50